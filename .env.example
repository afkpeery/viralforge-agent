# Required before running: generate via `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AGENT_API_KEY=CHANGE_ME_TO_LONG_RANDOM_VALUE
# Generate via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./viralforge.db
# Public HTTPS callback URLs registered with each developer console (local-only use a secure HTTPS tunnel)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-public-host.example/auth/tiktok/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-public-host.example/auth/instagram/callback
# Configurable Meta Graph version: verify against your approved Meta app
INSTAGRAM_GRAPH_VERSION=v24.0
# Optional licensed/authorized trend JSON feed with documented format
TREND_FEED_URL=
TREND_FEED_BEARER_TOKEN=
# Set to a real origin before exposing an application UI on a separate host
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional server-side AI review of retrieved public captions
OPENAI_API_KEY=
